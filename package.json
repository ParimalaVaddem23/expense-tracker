{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Expense Tracker: Express + SQLite + Zod + Swagger, tested with Mocha/Chai and Playwright",
  "main": "src/server.js",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test:unit": "mocha",
    "test:e2e": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:report": "playwright show-report",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "1.4.6",
    "express": "^4.21.0",
    "jsonwebtoken": "9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.7.3"
  }
}
